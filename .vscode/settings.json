    "Fira",
    "Gapcursor",
    "grayscale",
    "hljs",
    "Lowlight",
    "Menlo",
    "nesw",
    "Neue",
    "nwse",
    "pkce",
    "rgba",
    "Roboto",
    "Segoe",
    "supabase"
